# =====================================================================
# Caddyfile.prod.snippet — Blocco Caddy per produzione Ubuntu
# =====================================================================
# DA COPIARE/INCOLLARE nel /etc/caddy/Caddyfile del server di produzione.
# NON sostituisce il Caddyfile esistente: aggiunge un NUOVO host block.
#
# Hostname previsto: parolemutanti.maxster.top
# Porta interna:     3000 (dove gira il backend Node)
# TLS:               Let's Encrypt automatico via Cloudflare o custom cert
# =====================================================================

# --- Blocco principale: parolemutanti.maxster.top (HTTPS automatico) ---
parolemutanti.maxster.top {
    # Compressione gzip
    encode gzip zstd

    # Headers sicurezza
    header {
        # Protezione XSS / MIME sniffing
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # CSP per vanilla JS (aggiungere domini se servono asset esterni)
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss:; font-src 'self'"
        # HSTS (solo in HTTPS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    # Log dedicato (opzionale: richiede che la cartella esista e permessi corretti)
    log {
        output file /var/log/caddy/parole-mutanti.log {
            roll_size 10mb
            roll_keep 5
        }
    }

    # Reverse proxy al backend Node
    # IMPORTANTE: header Connection chiuso e buffering disattivato per WebSocket
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}

        # Timeout più lunghi per WebSocket
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
}

# --- (Opzionale) Blocco di fallback HTTP->HTTPS ---
# Decommentare se vuoi forzare redirect da http a https
# http://parolemutanti.maxster.top {
#     redir https://parolemutanti.maxster.top{uri} permanent
# }

# =====================================================================
# Note di deploy per Ubuntu:
#
# 1) Salva questo snippet in /etc/caddy/Caddyfile (o mergialo con il tuo esistente)
# 2) Crea la cartella log: sudo mkdir -p /var/log/caddy && sudo chown caddy:caddy /var/log/caddy
# 3) Testa config: sudo caddy validate --config /etc/caddy/Caddyfile
# 4) Ricarica: sudo systemctl reload caddy
#
# DNS: il dominio parolemutanti.maxster.top deve puntare all'IP del server.
# Se usi Cloudflare, abilita proxy e imposta SSL = Full (strict).
# =====================================================================
