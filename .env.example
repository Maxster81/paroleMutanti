# =====================================================================
# .env.example — Template variabili d'ambiente "Parole Mutanti"
# =====================================================================
# Copia questo file in `.env` e inserisci i valori reali.
# MAI committare il file `.env` reale.

# --- Server ---
# Porta di ascolto del processo Node.
# - Docker (deploy primario): il container ascolta su 8081 e il compose pubblica
#   127.0.0.1:8081. La porta NEL container è imposta dal compose.
# - Bare-metal (deploy/deploy.sh): allinea questa porta a --port (default 8090).
# - Dev WSL: 8081 (o altra porta libera: verifica con `ss -tlnp`).
PORT=8081
# Host di ascolto.
# - Dev WSL: 0.0.0.0 per essere raggiungibile da LAN/WSL.
# - Bare-metal dietro Caddy: 127.0.0.1.
# - Docker: SEMPRE sovrascritto a 0.0.0.0 dal compose (servono i bind interni).
HOST=0.0.0.0
# Ambiente: development | production (nel container il compose forza production)
NODE_ENV=development

# --- Database: Docker (container `db`) ---
# Credenziali del container PostgreSQL 16 creato da docker-compose.yml.
# Il compose costruisce DATABASE_URL da questi valori (host `db:5432`) e la passa
# all'app: per il flusso Docker NON devi scrivere DATABASE_URL qui sotto.
# POSTGRES_PASSWORD: usa solo caratteri sicuri per URL (es. `openssl rand -hex 24`),
# perché finisce dentro un URL postgresql://
# NOTA: se POSTGRES_PASSWORD o SESSION_SECRET sono vuote, `docker compose` si
# ferma subito con un messaggio esplicito (interpolazione ${VAR:?}).
POSTGRES_USER=parole_user
POSTGRES_PASSWORD=
POSTGRES_DB=parole_mutanti

# --- Database: dev / bare-metal (PostgreSQL sull'host) ---
# Serve SOLO se non usi Docker: in dev WSL o nel deploy bare-metal (systemd) con
# PostgreSQL installato sull'host. Nel container il compose sovrascrive questa
# variabile con quella interna alla rete Docker.
# DATABASE_URL=postgresql://parole_user:CAMBIAMI@localhost:5432/parole_mutanti
# Pool connessioni PostgreSQL (massimo) — default 10
DB_POOL_MAX=10

# --- AI: DeepSeek API ---
# Chiave API DeepSeek per fallback validazione parole
DEEPSEEK_API_KEY=sk-CAMBIAMI
# URL base DeepSeek (default già impostato nel codice)
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# Modello da usare
DEEPSEEK_MODEL=deepseek-chat
# Max chiamate/min per partita (rate limit)
DEEPSEEK_RATE_LIMIT_PER_MIN=10
# Abilita/disabilita il fallback AI (default true)
DEEPSEEK_ENABLED=true

# --- Gioco ---
# Limite massimo giocatori per partita (2-8)
MAX_PLAYERS=8
# Limite minimo giocatori per partita
MIN_PLAYERS=2
# Partite di default per "vittoria gioco" (1-4)
DEFAULT_GAMES_TO_WIN=2
# Tempo di default per turno in secondi (5-60)
DEFAULT_TURN_SECONDS=30
# Lunghezza parola iniziale minima
INITIAL_WORD_MIN_LENGTH=5
# Lunghezza parola iniziale massima
INITIAL_WORD_MAX_LENGTH=8
# Timer partenza lobby (secondi): con >=3 giocatori e >=2 pronti (ma non tutti),
# allo scadere i non-pronti vengono espulsi e i pronti entrano in partita.
# Configurabile SOLO da env, NON compare nell'app (default 30).
LOBBY_TIMER_SECONDS=30
# Visibilità di default delle nuove partite: true=pubblica (in home), false=privata.
# L'utente può comunque cambiarla al momento della creazione (default true).
DEFAULT_PUBLIC=true

# --- Sicurezza ---
# Segreto per generare ID sessione. In produzione (e quindi anche nel container,
# dove il compose forza NODE_ENV=production) DEVE essere >= 32 caratteri:
#   openssl rand -hex 32
# Se è vuoto, `docker compose` si ferma con un messaggio esplicito.
SESSION_SECRET=
# Origini consentite in CORS. In Docker/bare-metal il frontend è same-origin
# dietro Caddy, quindi va lasciato VUOTO (nessun CORS cross-origin necessario).
# In dev il default implicito è '*'. Es. https://parolemutanti.maxster.top
CORS_ORIGIN=

# --- Notifiche feedback (Telegram Bot, OPZIONALE) ---
# Se compilati, il form di feedback inoltra il messaggio a un bot Telegram
# (senza questi valori il feedback viene comunque salvato nel DB, senza notifica).
#
# Come ottenerli (guida completa: docs/DEPLOY.md §3.3):
# 1) TOKEN: su Telegram scrivi a @BotFather → /mybots (per rivedere il token di un
#    bot esistente) oppure /newbot (nuovo bot). Il token è del tipo 123456789:AA...
# 2) CHAT ID: scrivi un messaggio al bot e poi
#      curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"chat":{"id":[-0-9]*'
#    (per un gruppo l'id è negativo); in alternativa usa @userinfobot.
# Token sensibile: MAI committare.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
# Livello log: error | warn | info | debug
LOG_LEVEL=info

# --- Path pubblico (per produzione dietro reverse proxy) ---
# Vuoto in dev (root), path in produzione se servito sotto sottopath
PUBLIC_BASE_PATH=

# =====================================================================
# Solo container Docker (bootstrap avanzato) — valori di default
# =====================================================================
# Queste variabili NON servono nel flusso normale: `docker-compose.yml` imposta
# già SEED_WORDS=1 e DB_WAIT_SECONDS ha default 60. Sono elencate per chi vuole
# pilotare il bootstrap del container (vedi deploy/docker-entrypoint.sh).
# SEED_WORDS=1            # 0 = non popolare il dizionario al primo avvio
# DB_WAIT_SECONDS=60      # timeout (s) dell'attesa di PostgreSQL all'avvio
# SKIP_DB_BOOTSTRAP=1     # 1 = salta attesa DB + schema + seed (DB gestito a mano)
